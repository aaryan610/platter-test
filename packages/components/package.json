{
  "name": "@platter/components",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "build"
  ],
  "main": "./build/web/index.js",
  "module": "./build/web/index.js",
  "types": "./build/types/web/index.d.ts",
  "react-native": "./build/native/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./build/types/native/index.d.ts",
        "default": "./build/native/index.js"
      },
      "types": "./build/types/web/index.d.ts",
      "default": "./build/web/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf build && pnpm run build:web && pnpm run build:native && pnpm run check:build",
    "build:web": "rollup -c --environment PLATFORM:web",
    "build:native": "rollup -c --environment PLATFORM:native",
    "dev": "rollup -c -w",
    "check:build": "node scripts/check-build.mjs",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.native.json"
  },
  "dependencies": {
    "@platter/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1"
  }
}
